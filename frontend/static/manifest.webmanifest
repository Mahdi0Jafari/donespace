{
  "id": "/?source=pwa",
  "name": "DoneSpace — Modern Household & Chore Manager",
  "short_name": "DoneSpace",
  "description": "Gamified chore tracker and shared meal planner synced with Google Calendar.",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#fdfcff",
  "theme_color": "#8c52ff",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "lifestyle",
    "utilities"
